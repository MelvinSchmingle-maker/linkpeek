{
  "name": "linkpeek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LinkPeek browser extension: understand the link, check the risk, control the experience.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e && node scripts/build.mjs --e2e-on-demand",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "screenshots": "npm run build:e2e && SCREENSHOTS=1 playwright test screenshots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "eslint": "~10.11.0",
    "globals": "^17.13.0",
    "happy-dom": "~20.14.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "~7.3.7",
    "vitest": "~5.0.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "pdfjs-dist": "^6.3.289"
  }
}
