# Copy to .env for local runs. On Vercel, set these in Project Settings > Environment Variables.
# Never commit a real key, and never put it in the extension.

# Required. From https://console.anthropic.com (Settings > API keys).
ANTHROPIC_API_KEY=

# Optional. Which Claude model writes summaries. Default: claude-opus-5-5.
# Cheaper options: claude-sonnet-5-5, claude-haiku-5-5. See docs/cost/part-06-estimate.md.
SUMMARY_MODEL=

# Optional. "off" switches thinking off on Haiku 5.5 and Sonnet 5.5 (Opus 5.5 always thinks).
# Measured: no faster on Haiku and slightly worse sentences, so leave it unset (docs/cost/part-06-estimate.md).
SUMMARY_THINKING=

# Optional. "false" switches summaries off without a redeploy (every request gets 503).
SUMMARIES_ENABLED=

# Optional. On Vercel (VERCEL=1, set by Vercel) the Firewall rate-limit rule
# "summarise" is used, per install ID and per IP address (see server/README.md).
# Set to "memory" for local runs only. Anywhere else, every request is refused.
RATE_LIMITER=
