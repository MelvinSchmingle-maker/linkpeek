# Copy to .env for local runs. On Vercel, set these in Project Settings > Environment Variables.
# Never commit a real key, and never put it in the extension.

# Required. From https://console.anthropic.com (Settings > API keys).
ANTHROPIC_API_KEY=

# Optional. Which Claude model writes summaries. Default: claude-haiku-5-5 (see docs/cost/part-06-estimate.md).
# Cheaper options: claude-sonnet-5-5, claude-haiku-5-5. See docs/cost/part-06-estimate.md.
SUMMARY_MODEL=

# Optional. "off" switches thinking off on Haiku 5.5 and Sonnet 5.5 (Opus 5.5 always thinks).
# Measured: no faster on Haiku and slightly worse sentences, so leave it unset (docs/cost/part-06-estimate.md).
SUMMARY_THINKING=

# Optional. "false" switches summaries off without a redeploy (every request gets 503).
SUMMARIES_ENABLED=

# Optional. On Vercel (VERCEL=1, set by Vercel) the Firewall rate-limit rule
# "summarise" is used, per install ID and per IP address (see server/README.md).
# Set to "memory" for local runs only. Anywhere else, every request is refused.
RATE_LIMITER=

# ---------- Story Search (POST /api/story) ----------

# Which web search services, in order. Default "exa,tavily": Exa, then Tavily when Exa fails or its free credit is used up.
STORY_SEARCH_PROVIDER=

# Exa key. Free: $10 of credit a month, no card. From https://dashboard.exa.ai
EXA_API_KEY=

# Tavily key, the free backup. Free: 1,000 credits a month, no card. From https://app.tavily.com
TAVILY_API_KEY=

# Only if "brave" is added to STORY_SEARCH_PROVIDER. $5 free credit a month, but a card is required to sign up.
BRAVE_SEARCH_API_KEY=

# Optional. The Claude model for Story Search reports. Default: claude-haiku-5-5. claude-sonnet-5-5 matches stories more carefully at about 20 times the AI cost.
STORY_MODEL=

# Optional. low, medium (default) or high.
STORY_EFFORT=

# Optional. "false" switches Story Search off without a redeploy (every request gets 503 "disabled").
STORY_SEARCH_ENABLED=

# Optional. How many requests one Story Search counts as against the "summarise" rate-limit rule, in its own buckets. Default 3.
STORY_RATE_WEIGHT=
